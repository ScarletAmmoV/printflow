datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Taller {
  id        Int      @id @default(autoincrement())
  nombre    String
  usuario   String   @unique
  password  String
  createdAt DateTime @default(now())
  pedidos   Pedido[]
  
  // Nuevos campos de configuración
  metaToken       String?
  metaPhoneId     String?
  plantillaMensaje String? @default("*{taller}*: Hola {cliente}! Tu pedido #{orden} está listo para {entrega}.")
}

model Pedido {
  id                         Int       @id @default(autoincrement())
  tallerId                   Int
  taller                     Taller    @relation(fields: [tallerId], references: [id])
  numeroOrden                String
  nombreCliente              String
  apellidoCliente            String
  emailCliente               String?   // NUEVO: Email del cliente
  telefono                   String
  detalle                    String
  metodoEntrega              String
  estado                     String    @default("pendiente")
  estadoAnterior             String?
  fechaEntrada               DateTime  @default(now())
  notificacionProgramadaPara DateTime?
  notificacionEnviada        Boolean   @default(false)
  
  // NUEVO: Gestión de archivos de Gmail
  archivosAdjuntos           String?   // Lista de links separados por coma
  archivosImpresos           Boolean   @default(false)
}