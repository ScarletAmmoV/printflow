datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Taller {
  id        Int      @id @default(autoincrement())
  nombre    String
  usuario   String   @unique
  email     String?  @unique
  password  String
  createdAt DateTime @default(now())
  pedidos   Pedido[]
  
  // Configuración Meta
  metaToken       String?
  metaPhoneId     String?
  plantillaMensaje String? @default("*{taller}*: Hola {cliente}! Tu pedido #{orden} está listo para {entrega}.")
  
  // Tokens de Gmail
  gmailAccessToken  String?
  gmailRefreshToken String?

  // Recuperación de contraseña
  resetPasswordToken String?
  resetPasswordExpires DateTime?

  // PIN para métricas
  pinMetricas String?

  // Tokens de Tienda Nube
  tiendanubeToken String?
  tiendanubeStoreId Int?
}

model Pedido {
  id                         Int       @id @default(autoincrement())
  tallerId                   Int
  taller                     Taller    @relation(fields: [tallerId], references: [id])
  numeroOrden                String
  nombreCliente              String
  apellidoCliente            String
  emailCliente               String?
  dni                        String?   
  telefono                   String
  detalle                    String
  metodoEntrega              String
  precioTotal                Float?    
  estado                     String    @default("pendiente")
  estadoAnterior             String?
  fechaEntrada               DateTime  @default(now())
  notificacionProgramadaPara DateTime?
  notificacionEnviada        Boolean   @default(false)
  
  archivosAdjuntos           String?
  archivosImpresos           Boolean   @default(false)
}